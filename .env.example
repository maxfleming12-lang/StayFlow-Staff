# ---------------------------------------------------------------------
# StayFlow Staff — environment variables
#
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------

# --- Supabase: required ----------------------------------------------

# Project URL, from Supabase Dashboard → Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable ("anon") key. Safe to expose to browsers: it grants nothing
# on its own because every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Service-role key. BYPASSES Row Level Security entirely.
# Server-side only — it has no NEXT_PUBLIC_ prefix, so Next.js will not
# inline it into the browser bundle. Never expose it to client code, and
# in Vercel set it for Production/Preview only.
SUPABASE_SECRET_KEY=your-service-role-key

# --- Application ------------------------------------------------------

# Canonical origin, used to build password-reset and confirmation links.
# Locally this is http://localhost:3000. On Vercel it is inferred from the
# deployment when unset, but setting it explicitly for production avoids
# reset emails pointing at a preview URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
